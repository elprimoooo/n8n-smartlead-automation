    {
      "parameters": {
        "jsCode": "// Vstup: $input.item.json.lokalita (z OpenAI)\n// Vstup: items (řádky z Google Sheets - Makléři)\n\nconst poptavanaLokalita = $('OpenAI').first().json.lokalita.toLowerCase().trim();\nconst vsichniMakleri = items;\n\n// 1. Filtrace podle území a statusu\nlet vhodniKandidati = vsichniMakleri.filter(makler => {\n  const status = makler.json.status;\n  if (status!== 'Aktivní') return false;\n\n  const uzemiMaklere = makler.json.uzemi? makler.json.uzemi.toLowerCase() : \"\";\n  // Jednoduchá kontrola substringu (lze vylepšit o přesnější shodu)\n  return uzemiMaklere.includes(poptavanaLokalita);\n});\n\n// Pokud není nalezen žádný makléř, vyhodíme chybu nebo přiřadíme manažerovi\nif (vhodniKandidati.length === 0) {\n  return [{\n    json: {\n      found: false,\n      error: \"Žádný makléř pro tuto lokalitu\"\n    }\n  }];\n}\n\n// 2. Řazení kandidátů\n// Primárně: Preference (5 je nejvíc) -> Sestupně\n// Sekundárně: Čas posledního leadu (nejstarší první) -> Vzestupně\nvhodniKandidati.sort((a, b) => {\n  const prefA = parseInt(a.json.preference |\n\n| 0);\n  const prefB = parseInt(b.json.preference |\n\n| 0);\n\n  // Rozdíl preferencí\n  if (prefB!== prefA) {\n    return prefB - prefA;\n  }\n\n  // Pokud jsou preference stejné, rozhoduje čas\n  const timeA = new Date(a.json.posledni_lead |\n\n| 0).getTime();\n  const timeB = new Date(b.json.posledni_lead |\n\n| 0).getTime();\n  return timeA - timeB;\n});\n\n// 3. Výběr vítěze\nconst vitez = vhodniKandidati;\n\nreturn [{\n  json: {\n    found: true,\n    id_maklere: vitez.json.id_maklere,\n    jmeno: vitez.json.jmeno,\n    telefon: vitez.json.telefon,\n    row_number: vitez.json.row_number // Potřeba pro update\n  }\n}];"
      },
